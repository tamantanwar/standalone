# Copy to .env and fill in values for local dev
# In production, all secrets come from Google Secret Manager — never commit a real .env

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# GCP — project that owns the BigQuery `elt_meta_ads.creative_ai` table and GCS bucket
GCP_PROJECT_ID=generative-ai-418805
GCS_BUCKET_AD_IMAGES=kedet-ad-images

# API credentials — production uses Secret Manager
OPENAI_API_KEY=
GEMINI_API_KEY=
FB_ACCESS_TOKEN=
