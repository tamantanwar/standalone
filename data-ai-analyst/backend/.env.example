# Copy to .env and fill in values for local dev
# In production, all secrets come from Google Secret Manager — never commit a real .env

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# GCP — project + dataset that holds funnel_main / funnel_audience / funnel_conversions
GCP_PROJECT_ID=funnel-clients
BIGQUERY_DATASET=

# OpenAI — for local dev only. Production uses Secret Manager.
OPENAI_API_KEY=
