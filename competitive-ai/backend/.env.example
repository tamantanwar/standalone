# Copy to .env and fill in values for local dev
# In production, all secrets come from Google Secret Manager — never commit a real .env

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Third-party API credentials — production uses Secret Manager.
# Leave blank locally to fetch them from Secret Manager in GCP_PROJECT_ID
# (secrets: spyfu-api-key, serpapi-key, fb-access-token) using your
# `gcloud auth application-default login` credentials.
GCP_PROJECT_ID=kedetapplication
SPYFU_API_KEY=
SERPAPI_KEY=
FB_ACCESS_TOKEN=
SEARCH_API_KEY=
