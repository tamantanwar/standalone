# Top-level safety net. Each subfolder also has its own .gitignore.

# Secrets — never commit
.env
.env.*
!.env.example
!.env.local.example

# Service-account JSON
*-credentials.json
*-service-account*.json
*google-application-credentials*.json
funnel-clients-*.json
gcp-key*.json

# Node
node_modules/
.next/
out/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
